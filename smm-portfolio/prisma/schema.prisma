// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id          String   @id @default(cuid())
  name        String   @default("Марго")
  age         Int      @default(24)
  title       String   @default("SMM-маркетолог")
  description String   @default("Помогаю бизнесу расти через социальные сети в направлении психологии")
  photo       String   @default("/default-avatar.jpg")

  // Социальные сети
  telegram    String?
  instagram   String?
  threads     String?

  // Дополнительная информация
  location    String   @default("Казахстан")
  email       String?
  phone       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Portfolio {
  id              String   @id @default(cuid())
  postTitle       String   // Что за пост
  images          String   // JSON массив путей к изображениям
  workDescription String   // В чем заключалась работа Марго
  postLink        String?  // Ссылка на пост (опционально)
  category        String   // например: "Instagram", "Telegram", "Threads"
  order           Int      @default(0) // для сортировки

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContactForm {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  social     String   // Telegram или Instagram - обязательно
  socialType String   // 'telegram' или 'instagram'
  message    String
  isRead     Boolean  @default(false)
  status     String   @default("pending") // pending, contacted, rejected, working

  createdAt  DateTime @default(now())
}

// Редактируемые секции About
model AboutSection {
  id        String   @id @default(cuid())
  type      String   // 'aboutMe' или 'whyMe'
  title     String
  items     String   // JSON массив строк

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Сертификаты об образовании
model Certificate {
  id          String   @id @default(cuid())
  title       String
  organization String  // например: "Expert X", "АНО ДПО НАДПО"
  date        String   // дата получения
  image       String   // путь к изображению сертификата
  order       Int      @default(0) // для сортировки

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
